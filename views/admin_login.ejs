<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <%- include('partials/header', { section: section }) %>

  <main>
    <section class="hero" style="max-width:600px;margin:2rem auto;">
      <div>
        <h1>Admin login</h1>
        <p>Sign in with admin credentials to manage users and listings.</p>
      </div>
      <div class="hero-card">
        <% if (errors && errors.length) { %>
          <ul style="color:#b91c1c;padding-left:1rem;">
            <% errors.forEach(function(err){ %>
              <li><%= err %></li>
            <% }) %>
          </ul>
        <% } %>
        <form method="POST" action="/admin/l">
          <label>Username or email
            <input name="login" value="<%= form.login || '' %>" />
          </label>
          <label>Password
            <input name="password" type="password" />
          </label>
          <div style="margin-top:1rem;display:flex;gap:0.5rem;justify-content:flex-end;">
            <button class="primary-button" type="submit">Sign in</button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
